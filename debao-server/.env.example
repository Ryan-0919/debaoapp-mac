NODE_ENV=development
PORT=4000
HOST=0.0.0.0
DATABASE_URL=postgres://debao:debao@localhost:5432/debao
REDIS_URL=redis://localhost:6379
DEBAO_AUTH_SECRET=local-development-only-change-me
DEBAO_ADMIN_USERNAME=admin
DEBAO_ADMIN_PASSWORD=change-me-local
DEBAO_GRADING_ADMIN_USERNAME=grading-admin
DEBAO_GRADING_ADMIN_PASSWORD=change-me-grading-admin
DEBAO_LEARNING_ADMIN_USERNAME=learning-admin
DEBAO_LEARNING_ADMIN_PASSWORD=change-me-learning-admin
# Optional Base32 TOTP secret. When set, admin login requires /v1/admin/auth/mfa/verify.
# DEBAO_ADMIN_MFA_SECRET=
# Production defaults to true. A database administrator without MFA enrolls on first login.
DEBAO_ADMIN_MFA_REQUIRED=false
# Polyv account API credentials. Keep the secret on the server only.
POLYV_USER_ID=
POLYV_APP_ID=
POLYV_APP_SECRET=
# Polyv custom watch authorization uses a separate channel SecretKey.
POLYV_AUTH_SECRET=
POLYV_AUTH_CALLBACK_URL=https://api.example.com/v1/live/polyv/authorize
# Default amount (in CNY) at or above which refunds require two administrator reviews.
DEBAO_REFUND_REVIEW_THRESHOLD=1000
# One-time production administrator initialization (used by npm run admin:init only).
# ADMIN_INIT_USERNAME=
# ADMIN_INIT_PASSWORD=
# ADMIN_INIT_DISPLAY_NAME=超级管理员
PAYMENT_ADAPTER=unconfigured
SMS_ADAPTER=unconfigured
# For Alibaba Cloud SMS, use SMS_ADAPTER=aliyun and keep these values on the server only.
# SMS_PROVIDER_ACCESS_KEY_ID=
# SMS_PROVIDER_ACCESS_KEY_SECRET=
# SMS_SIGN_NAME=
# SMS_TEMPLATE_CODE=
PUSH_ADAPTER=unconfigured
GRADING_ADAPTER=unconfigured
AI_ADAPTER=unconfigured
MEDIA_ADAPTER=unconfigured
WECHAT_AUTH_ADAPTER=unconfigured
CARRIER_AUTH_ADAPTER=unconfigured
PROVIDER_TIMEOUT_MS=8000
# For http adapters, set the matching provider URL and key on the server only.
# PAYMENT_PROVIDER_URL=
# PAYMENT_PROVIDER_KEY=
# SMS_PROVIDER_URL=
# SMS_PROVIDER_KEY=
# PUSH_PROVIDER_URL=
# PUSH_PROVIDER_KEY=
# GRADING_PROVIDER_URL=
# GRADING_PROVIDER_KEY=
# AI_PROVIDER_URL=
# AI_PROVIDER_KEY=
# MEDIA_PROVIDER_URL=
# MEDIA_PROVIDER_KEY=
# WECHAT_AUTH_PROVIDER_URL=
# WECHAT_AUTH_PROVIDER_KEY=
# CARRIER_AUTH_PROVIDER_URL=
# CARRIER_AUTH_PROVIDER_KEY=
